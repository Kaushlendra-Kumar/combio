# Where the Go server lives. Both are read at build time by Next.js.
#
# Local development (go run ./cmd/server --addr :8080):
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# A deployed backend would look like:
# NEXT_PUBLIC_API_URL=https://combio-api.example.com
# NEXT_PUBLIC_WS_URL=wss://combio-api.example.com/ws
